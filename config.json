{
  "rules_base_dir": "raw",
  "finv_root": "../finv_category_V2",
  "upstream": {
    "url": "https://github.com/EliamZhang/ServiFlow-AI",
    "branch": "main"
  },
  "engine_priorities": {
    "initial": 10,
    "transfer": 1,
    "dishonour": 150,
    "gambling": 180,
    "income": 200,
    "liability": 300,
    "all_other_credit": 400,
    "fee": 500,
    "rent": 800,
    "catch_all": 999
  },
  "engines": {
    "initial": {
      "engine_dir": "initial_rule",
      "finv_engine_dir": "initial_engine",
      "finv_rule_dir": "",
      "rule_files": ["merchant_kb.csv"],
      "match_types": ["keyword"],
      "top_n_gaps": 100
    },
    "transfer": {
      "engine_dir": "transfer_rule",
      "finv_engine_dir": "transfer_engine",
      "finv_rule_dir": "resources",
      "rule_files": [
        "transfer_counterparty_rules.csv",
        "transfer_external_high_confidence_rules.csv",
        "transfer_external_medium_confidence_rules.csv",
        "transfer_internal_regex_rules.csv",
        "transfer_group_exclusion_patterns.csv",
        "transfer_indicator_patterns.csv",
        "transfer_pairing_exclusions.csv",
        "transfer_row_exclusion_patterns.csv"
      ],
      "match_types": ["keyword", "regex"],
      "top_n_gaps": 100,
      "note": "后 4 个 pattern/exclusion 文件于 2026-09-15 补入。此前不在 rule_files 里，导致 apply_rules.py:64 的 _detect_target_file 对它们的 target_file 抛 ValueError —— 异常在 :168 被捕获后仅记 error 并跳过该行，所以这类候选**永远落不了库**且不会中断整批。它们的 schema 与转账分类规则不同（pattern_id,pattern[,category],description / keyword,match_type,exclusion_reason,priority,description）。CLAUDE.md 说这些文件「通常不需要自动生成」，故实际影响有限，但漏登记会让将来真要写它们时静默失败。"
    },
    "dishonour": {
      "engine_dir": "dishonour_rule",
      "finv_engine_dir": "dishonour_engine",
      "finv_rule_dir": "resources",
      "rule_files": ["dishonour_rules.csv"],
      "match_types": ["keyword", "regex"],
      "top_n_gaps": 50
    },
    "gambling": {
      "engine_dir": "gambling_rule",
      "finv_engine_dir": "gambling_engine",
      "finv_rule_dir": "resources",
      "rule_files": ["gambling_rules.csv"],
      "match_types": ["keyword", "regex"],
      "top_n_gaps": 100,
      "note": "双层引擎（同 rent v2.0 机制）。institution 行（source=institution）是从 merchant_kb.csv 搬出来的 1,822 个 Gambling 商户，Aho-Corasick 全词匹配、最长 keyword 胜出；rule 行（source=rule）是原 catch_all 的 16 条通用赌博关键词，走 exclude_prior_claimed、最高 confidence 胜出。institution 层命中优先。priority=180，在 dishonour 之后、income 之前；其认领对 income/liability 是终局（orchestrator 丢弃这两个引擎在 gambling 已认领行上的预测）。"
    },
    "income": {
      "engine_dir": "income_rule",
      "finv_engine_dir": "income_engine",
      "finv_rule_dir": "resources",
      "rule_files": ["income_pattern_rules.csv"],
      "match_types": ["regex"],
      "top_n_gaps": 100,
      "note": "income_config.csv **刻意不在 rule_files 里**——它是阈值配置（config_key,config_value,config_type,description），不是候选规则的目标。它仍被 sync_rules.py / sync_upstream.py 覆盖（两者按目录实际 *.csv ∪ config 发现文件，不只看 rule_files）。"
    },
    "liability": {
      "engine_dir": "liability_rule",
      "finv_engine_dir": "liability_engine",
      "finv_rule_dir": "resources",
      "rule_files": [
        "counterparty_keyword_rules.csv",
        "credit_card_rules.csv",
        "debt_collection_rules.csv",
        "debt_consolidation_rules.csv",
        "dishonours_rules.csv",
        "home_loan_car_loan_rules.csv",
        "overdrawn_rules.csv"
      ],
      "match_types": ["keyword", "regex"],
      "top_n_gaps": 150,
      "note": "bnpl_maximum_limits.csv **刻意不在 rule_files 里**——它是限额配置（rate_type,counterparty,value），不是候选规则的目标。同 income_config.csv，它仍被两个 sync 脚本覆盖。"
    },
    "all_other_credit": {
      "engine_dir": "all_other_credit_rule",
      "finv_engine_dir": "all_other_credit_engine",
      "finv_rule_dir": "resources",
      "rule_files": ["all_other_credit_rules.csv"],
      "match_types": ["keyword"],
      "top_n_gaps": 50,
      "note": "代码中仅实现 keyword 匹配，regex 规则虽然 CSV schema 支持但运行时会被忽略。"
    },
    "fee": {
      "engine_dir": "fee_rule",
      "finv_engine_dir": "fee_engine",
      "finv_rule_dir": "resources",
      "rule_files": ["fee_classification_rules.csv"],
      "match_types": ["regex"],
      "top_n_gaps": 100,
      "note": "规则从 fee_classification_rules.csv 动态加载。可直接追加 CSV 添加新规则，无需修改 Python 源码。"
    },
    "rent": {
      "engine_dir": "rent_rule",
      "finv_engine_dir": "rent_engine",
      "finv_rule_dir": "resources",
      "rule_files": ["rent_rules.csv"],
      "match_types": ["keyword", "regex"],
      "top_n_gaps": 50,
      "note": "rent_engine 在 clean_text() 后的大写文本上做全词 keyword / regex 匹配，最高 confidence 胜出。orchestrator 层已排除 income/liability 认领的行。"
    },
    "catch_all": {
      "engine_dir": "catch_all_rule",
      "finv_engine_dir": "catch_all_engine",
      "finv_rule_dir": "resources",
      "rule_files": ["catch_all_rules.csv"],
      "match_types": ["keyword", "regex"],
      "top_n_gaps": 200
    }
  },
  "analysis": {
    "min_pattern_length": 3,
    "min_pattern_frequency": 5,
    "normalization": {
      "remove_dates": true,
      "remove_amounts": true,
      "remove_numbers": true,
      "uppercase": true
    }
  },
  "pattern_classification": {
    "rent_indicators": [
      "RENT", "RENTAL", "RENTALS", "TENANCY", "TENANT", "LANDLORD",
      "PROPERTY MANAG", "REAL ESTATE", "REALTY", "STRATA",
      "OWNERS CORP", "LEASE", "LETTING", "BODY CORPORATE"
    ],
    "gambling_indicators": [
      "CASINO", "BET ", "BETTING", "GAMBLING", "POKER", "SLOTS",
      "LIMASSOL", " NICOSIA ", " MALTA ", " CYP",
      "PLAYTKA", "CAESARS", "TAB ", "SPORTSBET", "LADBROKES",
      "GARETON BV", "FRVN", "SCRN", "BTZ", "BETR",
      "CASINY", "BET RIGHT", "BETDELUXE", "PUNTIQ",
      "PLAYUP", "DABBLE", "SURGE AU"
    ],
    "card_purchase_prefixes": [
      "DEBIT CARD PURCHASE ",
      "VISA DEBIT PURCHASE CARD ",
      "EFTPOS DEBIT ",
      "EFTPOS ",
      "RETAIL PURCHASE "
    ],
    "business_indicators": [
      " PTY LTD", " PTY. LTD.", " PTY L",
      "SQ *", "ZLR*", "TFR ",
      " AUS CARD", "CARD XX",
      "WDL ATM ", "CBA ATM ",
      "WITHDRAWAL - "
    ],
    "generic_keywords": [
      "RESTAURANT", "CAFE", "PHARMACY", "SUPERMARKET",
      "MARKET ", "BAKERY", "BUTCHER", "TAKEAWAY", "PIZZA",
      "MEDICAL", "DENTAL", "SALON", "BARBER", "GROCER",
      "ATM ", "PETROL", "SERVICE STATION",
      "INSURANCE", "HARDWARE", "FITNESS", "GYM",
      "LAUNDROMAT", "NEWSAGENCY", "CONVENIENCE",
      "CHILDCARE", "KINDERGARTEN", "SCHOOL",
      "CINEMA", "TOBACCONIST", "LIQUOR",
      "FRUIT ", "BUTCHER", "HOTEL", "MOTEL",
      "DENTIST", "DOCTOR"
    ],
    "online_indicators": [
      "REVOLUT", "PAYPAL", "WISE ", "STRIPE", "SQUARE",
      "APPLE.COM", "GOOGLE ", "MICROSOFT", "AMAZON",
      "SPOTIFY", "NETFLIX", "DISNEY",
      " AFTERPAY", "KLARNA",
      "AVIAGAMES", "IMGVIDES", "DEGABEAT",
      "TG TALLINN", "INCEUNION", "SKMG",
      "CLIPVIDOREU", "SPRIGGY",
      "COURTNEY TIESTO"
    ]
  },
  "large_files": {
    "merchant_kb.csv": {
      "skip_pattern_loading": true,
      "note": "874,600 merchants with 1,338,895 keyword variants (2026-09-15 实测). Skip for overlap checking to avoid OOM."
    }
  },
  "validation": {
    "_note": "⚠️ 本段当前**没有任何脚本读取**（2026-09-15 全仓 grep 零命中）。改这两个值不会有任何效果——不要以为设了 max_regression_changes=0 就会被强制零回归检查。保留仅为将来实现的占位。",
    "sample_hit_count": 5,
    "max_regression_changes": 0
  }
}
