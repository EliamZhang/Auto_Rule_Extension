# Python
__pycache__/
*.py[cod]
*.egg-info/

# Virtual environment
.venv/
venv/

# IDE
.idea/
.vscode/

# OS
.DS_Store
Thumbs.db

# Reviews (generated per run)
reviews/*
!reviews/.gitkeep

# Baseline snapshots
baseline/*
!baseline/.gitkeep

# Assessment reports (generated per run)
reports/*
!reports/.gitkeep

# assessment 模块迁移前的旧产物目录（模块现在写 reports/<时间戳>/）。
# 2026-09-15 已取消追踪；保留忽略规则，免得残留文件变成 untracked 噪音
modules/assessment/output/

# Input data (user-managed)
input/*
!input/.gitkeep

# Backup files
*.bak
raw/**/*.bak
# merchant_kb 的 keyword 列清洗前快照，命名是 _bak 不是 .bak，上面两条拦不住。
# 2026-09-15 已取消追踪（53.8 MB），规则保留以防再次误入
raw/initial_rule/*_bak

# sync_upstream.py 的上游缓存（blobless 裸仓库，只有 commit/tree，无文件正文）
.upstream_cache/

# Monitor artifacts
scripts/.monitor/

# Label compare reports (generated per run)
category_difference_report*.xlsx

# Flowchart drafts (ad-hoc, not part of the project)
framework_flowchart.html


