# Python
__pycache__/
*.py[cod]
*.egg-info/

# Virtual environment
.venv/
venv/

# IDE
.idea/
.vscode/

# OS
.DS_Store
Thumbs.db

# Reviews (generated per run)
reviews/*
!reviews/.gitkeep

# Baseline snapshots
baseline/*
!baseline/.gitkeep

# Assessment reports (generated per run)
reports/*
!reports/.gitkeep

# Input data (user-managed)
input/*
!input/.gitkeep

# Backup files
*.bak
raw/**/*.bak

# sync_upstream.py 的上游缓存（blobless 裸仓库，只有 commit/tree，无文件正文）
.upstream_cache/

# Monitor artifacts
scripts/.monitor/

# Label compare reports (generated per run)
category_difference_report*.xlsx

# Flowchart drafts (ad-hoc, not part of the project)
framework_flowchart.html


